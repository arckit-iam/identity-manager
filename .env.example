# Variables pour `docker compose up` (développement local uniquement).
# Copier vers `.env` (ignoré par git) et remplacer les valeurs.

POSTGRES_DB=identity_manager
POSTGRES_USER=identity_manager
POSTGRES_PASSWORD=change-me

# arc-auth : valeur attendue du claim iss (= ARC_AUTH_JWT_ISSUER d'arc-auth)
ARC_SECURITY_ISSUER_URI=http://arc-auth:8082

# Compte de service (rôle ARC_PUBLISHER) utilisé pour appeler arc-publisher
ARC_AUTH_USERNAME=svc-identity-manager
ARC_AUTH_PASSWORD=change-me

# URL d'arc-auth et d'arc-publisher (optionnel)
# ARC_AUTH_URL=http://arc-auth:8082
# ARC_SECURITY_JWK_SET_URI=http://arc-auth:8082/.well-known/jwks.json
# ARC_PUBLISHER_URL=http://arc-publisher:8081

# Types de compte utilisateur (définis par le déploiement)
# ARC_ACCOUNTS_TYPES_0_NAME=employee
# ARC_ACCOUNTS_TYPES_0_KIND=USER
# ARC_ACCOUNTS_TYPES_0_PATTERN=(?<identity>[a-z]+[0-9]+)(-adm)?
# ARC_ACCOUNTS_TYPES_0_METADATA_0_NAME=department
# ARC_ACCOUNTS_TYPES_0_METADATA_0_TYPE=STRING
# ARC_ACCOUNTS_TYPES_0_METADATA_0_REQUIRED=true

# Découverte des comptes depuis Kafka (optionnel)
# ARC_DISCOVERY_ENABLED=true
# ARC_DISCOVERY_TOPIC=arc.sync.identity
# SPRING_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
